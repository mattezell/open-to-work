{
  "name": "open-to-work",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A 16-bit co-op beat 'em up about the hiring process: laid off Tuesday, shipped by Friday",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "dev": "sh tools/with-commit-dates.sh vite",
    "build": "tsc --noEmit && sh tools/with-commit-dates.sh vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:tools": "python3 -m unittest discover -s tools",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run test:tools"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "prettier": "^3.9.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
